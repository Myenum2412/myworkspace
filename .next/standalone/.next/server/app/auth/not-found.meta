{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/auth/layout,_N_T_/auth/not-found/layout,_N_T_/auth/not-found/page,_N_T_/auth/not-found"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/auth/not-found/__PAGE__",
    "/auth/not-found",
    "/auth",
    "/_index",
    "/_head"
  ]
}