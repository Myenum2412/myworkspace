{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/terminated/layout,_N_T_/terminated/page,_N_T_/terminated"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/terminated/__PAGE__",
    "/terminated",
    "/_index",
    "/_head"
  ]
}