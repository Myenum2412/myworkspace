{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/gallery/layout,_N_T_/gallery/view/layout,_N_T_/gallery/view/page,_N_T_/gallery/view"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/gallery/view/__PAGE__",
    "/gallery/view",
    "/gallery",
    "/_index",
    "/_head"
  ]
}