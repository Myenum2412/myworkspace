{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/my-time/layout,_N_T_/my-time/page,_N_T_/my-time"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
