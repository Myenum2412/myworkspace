            {
              "type": "query",
              "key": "o",
              "value": "(?<orgid>\\d*)"
            },
            {
              "type": "query",
              "key": "p",
              "value": "(?<projectid>\\d*)"
            },
            {
              "type": "query",
              "key": "r",
              "value": "(?<region>[a-z]{2})"
            }
          ],
          "destination": "https://o:orgid.ingest.:region.sentry.io/api/:projectid/envelope/?hsts=0"
        },
        {
          "source": "/monitoring(/?)",
